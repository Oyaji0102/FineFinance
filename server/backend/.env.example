# FineFin Backend - Ortam Değişkenleri Şablonu
# Bu dosyayı kopyalayıp .env olarak kaydedin ve değerleri doldurun.
# .env dosyası GIT'e push edilmez - güvende kalır.

# --- Gemini AI ---
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# --- JWT Güvenlik ---
SECRET_KEY=GUCLU_BIR_RASTGELE_STRING_GIRIN
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Veritabanı ---
DATABASE_URL=sqlite+aiosqlite:///./finefinance.db
